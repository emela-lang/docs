{
  "name": "beryl-light",
  "displayName": "Beryl Light",
  "type": "light",
  "colors": {
    "editor.background": "#F4F8F7",
    "editor.foreground": "#1E3732",
    "editor.selectionBackground": "#CDE9E1"
  },
  "tokenColors": [
    {
      "name": "Comment",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#5E756F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Doc comment",
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation"
      ],
      "settings": {
        "foreground": "#4F6A63"
      }
    },
    {
      "name": "String",
      "scope": [
        "string",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A04A1E"
      }
    },
    {
      "name": "Escape",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#0F6353"
      }
    },
    {
      "name": "Interpolation",
      "scope": [
        "punctuation.section.embedded",
        "punctuation.definition.template-expression",
        "punctuation.section.interpolation"
      ],
      "settings": {
        "foreground": "#0F6353"
      }
    },
    {
      "name": "Number, constant",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other",
        "support.constant"
      ],
      "settings": {
        "foreground": "#6B4BB0"
      }
    },
    {
      "name": "Keyword",
      "scope": [
        "keyword",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.word",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#0F6353",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Operator",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#1E3732",
        "fontStyle": ""
      }
    },
    {
      "name": "Effect entry",
      "scope": [
        "keyword.control.flow.await",
        "storage.modifier.async",
        "keyword.control.async"
      ],
      "settings": {
        "foreground": "#107460",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Failure path",
      "scope": [
        "keyword.control.exception",
        "keyword.control.trycatch",
        "keyword.control.flow.throw"
      ],
      "settings": {
        "foreground": "#B03A4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Function",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1F5F9A"
      }
    },
    {
      "name": "Macro",
      "scope": [
        "entity.name.function.macro",
        "support.macro",
        "support.function.macro"
      ],
      "settings": {
        "foreground": "#107460"
      }
    },
    {
      "name": "Type",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface",
        "entity.name.trait",
        "entity.other.inherited-class",
        "support.type",
        "support.class",
        "storage.type.primitive",
        "storage.type.numeric"
      ],
      "settings": {
        "foreground": "#7A5410",
        "fontStyle": ""
      }
    },
    {
      "name": "Parameter",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#B03A4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "self, this",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#B03A4F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Field",
      "scope": [
        "variable.other.member",
        "variable.other.property",
        "variable.other.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.name.tag.yaml",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#2E6E62"
      }
    },
    {
      "name": "Module",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "support.module"
      ],
      "settings": {
        "foreground": "#1E3732",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Attribute",
      "scope": [
        "meta.annotation",
        "meta.attribute",
        "entity.name.function.decorator",
        "punctuation.definition.annotation"
      ],
      "settings": {
        "foreground": "#0F6353"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#3F524D"
      }
    },
    {
      "name": "Tag",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#0F6353"
      }
    },
    {
      "name": "Tag attribute",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#7A5410",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#B5461E"
      }
    },
    {
      "name": "Heading",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0F6353",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Bold",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "fontStyle": "bold"
      }
    },
    {
      "name": "Italic",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "fontStyle": "italic"
      }
    },
    {
      "name": "Raw",
      "scope": [
        "markup.raw",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A04A1E"
      }
    },
    {
      "name": "Link",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1F5F9A",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Quote",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#5E756F",
        "fontStyle": "italic"
      }
    },
    {
      "name": "List marker",
      "scope": [
        "punctuation.definition.list",
        "markup.list.numbered.bullet"
      ],
      "settings": {
        "foreground": "#0F6353"
      }
    },
    {
      "name": "Inserted",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#107460"
      }
    },
    {
      "name": "Deleted",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#B5461E"
      }
    },
    {
      "name": "Changed",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#7A5410"
      }
    },
    {
      "name": "Emela parameter",
      "scope": [
        "variable.parameter.emela"
      ],
      "settings": {
        "foreground": "#1E3732",
        "fontStyle": "italic"
      }
    }
  ]
}
