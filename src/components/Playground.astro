---
// The dedicated /playground editor: a source textarea, Run and Format buttons, and an output
// panel. The markup matches buildPlayground in src/scripts/emela-playground.ts, which wires it.
// The compiler wasm is fetched on first use.
const sample = `import Std.Console.{Console}
import Std.Platform.{Platform}

error NotFound(id: Int)

fn find(id: Int) -> String fails NotFound {
  if id == 1 { "alice" } else { fail NotFound(id:) }
}

fn main() {
  with Platform {
    console = use Console
    console.print_line("Hello, #{find(1)}!")
    console.print_line(find(2) escape { NotFound(_) -> "guest" })
  }
}
`;---

<div class="emela-playground not-content">
  <div class="emela-pg-editor-wrap">
    <textarea class="emela-pg-editor" spellcheck="false" autocapitalize="off" autocorrect="off" aria-label="Emela ソース">{sample}</textarea>
  </div>
  <div class="emela-pg-bar">
    <button type="button" class="emela-run-btn emela-pg-run">
      <span aria-hidden="true">▶</span> Run
    </button>
    <button type="button" class="emela-run-btn emela-pg-format">整形</button>
    <span class="emela-pg-hint">Ctrl / ⌘ + Enter で実行。ファイル、環境変数、標準入力、HTTP はブラウザでは使えません。</span>
  </div>
  <div class="emela-run-output emela-pg-output" hidden></div>
</div>

<script>
  import { mountPlayground } from '../scripts/emela-playground';

  function init(): void {
    document.querySelectorAll<HTMLElement>('.emela-playground').forEach(mountPlayground);
  }

  init();
  document.addEventListener('astro:page-load', init);
</script>
