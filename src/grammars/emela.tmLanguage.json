{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "emela",
  "scopeName": "source.emela",
  "fileTypes": ["em", "emela"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#function-definition" },
    { "include": "#type-definition" },
    { "include": "#keywords" },
    { "include": "#constants" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#types" },
    { "include": "#function-call" },
    { "include": "#operators" },
    { "include": "#punctuation" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.documentation.emela",
          "match": "///.*$"
        },
        {
          "name": "comment.line.double-slash.emela",
          "match": "//.*$"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "storage.modifier.attribute.emela",
          "match": "@[a-z_][A-Za-z0-9_]*"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.emela",
          "match": "\\b(if|else|case|match|of|when|with|use|do)\\b"
        },
        {
          "name": "keyword.declaration.emela",
          "match": "\\b(let|const|fn|type|pub|opaque|import|module|open|external|as|and|rec|in)\\b"
        },
        {
          "name": "keyword.other.emela",
          "match": "\\b(assert|todo|panic)\\b"
        }
      ]
    },
    "function-definition": {
      "match": "\\b(fn)\\s+([a-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.emela" },
        "2": { "name": "entity.name.function.emela" }
      }
    },
    "type-definition": {
      "match": "\\b(type)\\s+([A-Z][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.declaration.emela" },
        "2": { "name": "entity.name.type.emela" }
      }
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.emela",
          "match": "\\b(True|False|Nil|true|false)\\b"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.emela",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.emela",
              "match": "\\\\(u\\{[0-9A-Fa-f]+\\}|[\\\\\"nrt0]|.)"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.emela",
          "match": "\\b(0[bB][01][01_]*|0[oO][0-7][0-7_]*|0[xX][0-9A-Fa-f][0-9A-Fa-f_]*|[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "entity.name.type.emela",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "function-call": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(?=\\()",
          "name": "entity.name.function.call.emela"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.emela",
          "match": "(\\|>|->|<-|<>|==|!=|<=|>=|&&|\\|\\||\\.\\.|[+\\-*/%<>=!&|]|:)"
        }
      ]
    },
    "punctuation": {
      "patterns": [
        {
          "name": "punctuation.separator.emela",
          "match": "[,;]"
        },
        {
          "name": "punctuation.accessor.emela",
          "match": "\\."
        }
      ]
    }
  }
}
