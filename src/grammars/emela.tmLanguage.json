{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "emela",
  "scopeName": "source.emela",
  "fileTypes": ["emel"],
  "patterns": [{ "include": "#code" }],
  "repository": {
    "code": {
      "patterns": [
        { "include": "#comments" },
        { "include": "#strings" },
        { "include": "#annotations" },
        { "include": "#numbers" },
        { "include": "#keywords" },
        { "include": "#constants" },
        { "include": "#types" },
        { "include": "#functions" },
        { "include": "#operators" }
      ]
    },
    "comments": {
      "patterns": [
        { "match": "##.*$", "name": "comment.line.documentation.emela" },
        { "match": "#.*$", "name": "comment.line.number-sign.emela" }
      ]
    },
    "strings": {
      "patterns": [
        {
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "name": "string.quoted.triple.emela",
          "patterns": [{ "include": "#string-content" }]
        },
        {
          "begin": "\"",
          "end": "\"",
          "name": "string.quoted.double.emela",
          "patterns": [{ "include": "#string-content" }]
        }
      ]
    },
    "string-content": {
      "patterns": [
        { "match": "\\\\u\\{[0-9A-Fa-f]{1,6}\\}", "name": "constant.character.escape.emela" },
        { "match": "\\\\[\"\\\\ntr#]", "name": "constant.character.escape.emela" },
        {
          "begin": "#\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.emela" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.emela" } },
          "name": "meta.interpolation.emela",
          "contentName": "source.emela",
          "patterns": [{ "include": "#code" }]
        }
      ]
    },
    "annotations": {
      "match": "@[a-z_][A-Za-z0-9_]*",
      "name": "storage.type.annotation.emela"
    },
    "numbers": {
      "patterns": [
        { "match": "\\b0x[0-9A-Fa-f][0-9A-Fa-f_]*\\b", "name": "constant.numeric.hex.emela" },
        { "match": "\\b0b[01][01_]*\\b", "name": "constant.numeric.binary.emela" },
        { "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9][0-9_]*)?\\b", "name": "constant.numeric.float.emela" },
        { "match": "\\b[0-9][0-9_]*\\b", "name": "constant.numeric.integer.emela" }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "match": "\\b(if|else|match|fail|escape|use|with|assert)\\b",
          "name": "keyword.control.emela"
        },
        {
          "match": "\\b(fn|type|enum|error|const|trait|impl|effect|handler|layer|import)\\b",
          "name": "keyword.declaration.emela"
        },
        {
          "match": "\\b(pub|opaque|suspend)\\b",
          "name": "storage.modifier.emela"
        },
        {
          "match": "\\b(implements|for|fails|derive|init|release|of|default|by)\\b",
          "name": "keyword.other.emela"
        },
        {
          "match": "\\b(self|Self)\\b",
          "name": "variable.language.self.emela"
        }
      ]
    },
    "constants": {
      "patterns": [
        { "match": "\\b(True|False)\\b", "name": "constant.language.boolean.emela" },
        { "match": "\\b[A-Z][A-Z0-9_]*\\b(?![a-z])", "name": "constant.other.emela" }
      ]
    },
    "types": {
      "patterns": [
        {
          "match": "\\b(Int|Int64|Float|Bool|String|Never|List|Option|Ordering)\\b",
          "name": "support.type.builtin.emela"
        },
        { "match": "\\b[A-Z][A-Za-z0-9]*\\b", "name": "entity.name.type.emela" }
      ]
    },
    "functions": {
      "match": "\\b([a-z_][A-Za-z0-9_]*)(?=\\()",
      "captures": { "1": { "name": "entity.name.function.emela" } }
    },
    "operators": {
      "patterns": [
        { "match": "\\|>|->|==|!=|<=|>=|&&|\\|\\||\\.\\.", "name": "keyword.operator.emela" },
        { "match": "[+\\-*/%<>!=|]", "name": "keyword.operator.emela" }
      ]
    }
  }
}
